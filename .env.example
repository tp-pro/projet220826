# Copier ce fichier en .env.local puis remplir avec vos propres valeurs.
# .env.local n'est jamais commit (voir .gitignore).

NEXT_PUBLIC_APP_URL=

# Connexion Postgres Supabase — Project Settings > Database > Connection string > URI
# (utiliser la version "Transaction pooler", port 6543)
DATABASE_URL=

# Supabase Auth — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ Clé secrète — bypass RLS, ne jamais exposer au client, ne jamais préfixer NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=